PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/nalli_bokka
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Access tokens expire after one hour.
CORS_ORIGIN=http://localhost:5173

RENFLAIR_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional outside Render; public API origin used for Razorpay redirect callbacks.
PUBLIC_API_URL=
RECONCILE_MIN_AGE_MINUTES=10

# Production always uses MongoDB; opt in for local multi-process development.
RATE_LIMIT_STORE=mongo
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct access.
TRUSTED_PROXIES=
